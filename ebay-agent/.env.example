# Copy to .env (or export these in your shell). Never commit real keys.

# Claude API key - https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# eBay developer keys - https://developer.ebay.com/my/keys
# Leave these blank to run in MOCK mode with fake listings.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# "production" for real listings, "sandbox" for eBay's test data
EBAY_ENV=production
# Which eBay site to search, e.g. EBAY_US, EBAY_GB, EBAY_DE
EBAY_MARKETPLACE=EBAY_US
